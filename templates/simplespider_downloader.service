[Unit]
Description=SimpleSpider Crawler
After=network.target

[Service]
User=test
Group=test
WorkingDirectory={{ PROJECT_ROOT }}/backend/
ExecStart={{ VENV_ROOT }}/bin/python manage.py start_downloader
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
